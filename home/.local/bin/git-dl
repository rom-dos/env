#!/usr/bin/env bash
# git-dl: delete the last checked-out branch (the one `git checkout -` would switch to).
# Usage: git dl
# Asks for confirmation; asks again before force-deleting a branch that isn't fully merged.
set -euo pipefail

git rev-parse --git-dir >/dev/null 2>&1 || { echo "git-dl: not a git repository" >&2; exit 1; }

# @{-1} resolves to refs/heads/<name> only if the previous checkout was a branch that still exists.
ref=$(git rev-parse --symbolic-full-name '@{-1}' 2>/dev/null || true)
if [[ "$ref" != refs/heads/* ]]; then
  echo "git-dl: no previous branch found (none checked out, it was a detached HEAD, or it no longer exists)" >&2
  exit 1
fi
branch=${ref#refs/heads/}

if [[ "$branch" == "$(git branch --show-current)" ]]; then
  echo "git-dl: previous branch '$branch' is the current branch" >&2
  exit 1
fi

read -r -p "Delete branch '$branch'? [y/N] " answer </dev/tty
[[ "$answer" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }

if err=$(git branch -d "$branch" 2>&1); then
  echo "$err"
elif [[ "$err" == *"not fully merged"* ]]; then
  read -r -p "Branch '$branch' is not fully merged. Force delete? [y/N] " answer </dev/tty
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    git branch -D "$branch"
  else
    echo "Aborted."
  fi
else
  echo "$err" >&2
  exit 1
fi
