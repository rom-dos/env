#!/usr/bin/env bash
# git-fc: fuzzy-checkout a local git branch using fzf.
# Usage: git fc
set -euo pipefail

git rev-parse --git-dir >/dev/null 2>&1 || { echo "git-fc: not a git repository" >&2; exit 1; }

# Exclude the current branch (marked with "*") since you're already on it.
branch=$(git branch | grep -v '^\*' | sed 's/^[ +]*//' | fzf --prompt="checkout branch> " --height=40% --reverse) || exit 0
[[ -z "$branch" ]] && exit 0

git checkout "$branch"
